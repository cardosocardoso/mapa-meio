{
  "name": "mapa-meio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Equal-drive-time meeting point finder (self-hosted, Valhalla + Photon + MapLibre)",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "PORT=3100 node --watch server/index.mjs",
    "dev:web": "vite",
    "build": "vite build",
    "build:geo": "node scripts/build-geodata.mjs",
    "start": "NODE_ENV=production node server/index.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/static": "^9.1.3",
    "@turf/turf": "^7.3.5",
    "better-sqlite3": "^12.10.0",
    "fastify": "^5.8.5",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "maplibre-gl": "^5.24.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
